--- !u!114 &5017511082967039072
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6891551410465780731}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<color=#D9891A><b>MOVEMENT</b></color>

    <alpha=#99>WASD<alpha=#FF> 
    move      <alpha=#99>Mouse<alpha=#FF>  look      <alpha=#99>Space<alpha=#FF> 
    jump (release early for a short hop)

    <alpha=#99>Left Shift<alpha=#FF>  dash     
    <alpha=#99>Left Ctrl<alpha=#FF>  Slide (needs speed; jump out of it to keep it)

    <alpha=#99>Space<alpha=#FF>
    again near a wall: wall jump      <alpha=#99>no key<alpha=#FF>: arrive airborne
    along a wall at a jog to wall run

    <alpha=#99>Perfect timing<alpha=#FF>:
    press Space at WALL EXIT or DASH JUMP; the cue marks the real window. A grapple
    burst fired on landing also refunds stamina


    <color=#D9891A><b>COMBAT</b></color>

    <alpha=#99>LMB<alpha=#FF> 
    attack      <alpha=#99>RMB tap<alpha=#FF>  parry      <alpha=#99>RMB hold<alpha=#FF> 
    guard      <alpha=#99>MMB<alpha=#FF>  lock on / switch / release

    <alpha=#99>LMB<alpha=#FF>
    at an enemy carrying the violet marker: deathblow      <alpha=#99>Q<alpha=#FF> 
    super (needs a full PYRE)

    Parry to break their POSTURE, then deathblow.
    Blocking costs YOUR posture. Every parry stokes PYRE.


    <color=#D9891A><b>ITEMS
    AND MENUS</b></color>

    <alpha=#99>E<alpha=#FF>  use item      <alpha=#99>F<alpha=#FF> 
    flask (or CHOOSE WAND at an altar)      <alpha=#99>1 2 3 / wheel<alpha=#FF> 
    weapon      <alpha=#99>Tab<alpha=#FF>  level up      <alpha=#99>Esc<alpha=#FF> 
    pause

    <alpha=#99>F11<alpha=#FF>  weapon flourish (cosmetic - rebind it under
    SETTINGS > CONTROL > FLOURISH KEY)


    <color=#D9891A><b>LEVEL EDITOR</b></color> 
    (editor and development builds only - F10, or F1 > LEVEL EDITOR; see docs/LEVEL-EDITOR.md)

    <alpha=#99>WASD
    / Space / Ctrl / Shift<alpha=#FF>  fly, up, down, fast      <alpha=#99>Tab<alpha=#FF> 
    toggle the cursor (free on enter)

    <alpha=#99>LMB tap<alpha=#FF>  place     
    <alpha=#99>LMB hold 0.18 s<alpha=#FF>  grab and carry a piece      <alpha=#99>RMB
    / X<alpha=#FF>  delete the aimed piece

    <alpha=#99>Wheel<alpha=#FF>  size     
    <alpha=#99>Shift + wheel / [ ]<alpha=#FF>  piece kind      <alpha=#99>Ctrl +
    wheel / V<alpha=#FF>  variant      <alpha=#99>T<alpha=#FF>  rotate 90 deg

    Panel:
    NEW  SAVE  LOAD  PLAY  EXPORT ASSET  EXIT.   Files: AppData/LocalLow/vibegame1/vibegame1/levels


    <color=#D9891A><b>DEV
    KEYS</b></color>  (editor and development builds)

    <alpha=#99>F1<alpha=#FF> 
    test menu      <alpha=#99>F5<alpha=#FF>  warp to boss      <alpha=#99>F6<alpha=#FF> 
    full restore      <alpha=#99>F7<alpha=#FF>  +1000 souls      <alpha=#99>F8<alpha=#FF> 
    god mode      <alpha=#99>4<alpha=#FF>  dev blade'
